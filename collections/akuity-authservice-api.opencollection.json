{
  "opencollection": "1.0.0",
  "info": {
    "name": "Akuity Platform API — Auth Auth Service API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "AuthService",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Device Code",
